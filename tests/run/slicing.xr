// Slicing arrays, slices and strings with ranges.

fn sum(xs: &[i32]) -> i32 {
    let mut t = 0
    for x in xs {
        t += *x
    }
    t
}

fn zero(xs: &mut [i32]) {
    for x in xs {
        *x = 0
    }
}

fn main() {
    let mut a = [1, 2, 3, 4, 5, 6]
    println(sum(&a[1..4]))        // 2 + 3 + 4
    println(sum(&a[..2]))         // 1 + 2
    println(sum(&a[4..]))         // 5 + 6
    println(sum(&a[..]))          // all
    println(sum(&a[2..=3]))       // 3 + 4
    println(a[1..4].len())

    // slice of a slice
    let s: &[i32] = &a[1..5]
    let inner = &s[1..3]
    println(inner[0])
    println(inner.len())

    // mutable slice
    zero(&mut a[0..3])
    println(sum(&a))              // 0 + 0 + 0 + 4 + 5 + 6

    // empty slices are fine
    println(a[3..3].len())

    // strings
    let text = "hello, xero"
    println(&text[0..5])
    println(&text[7..])
    let word = &text[7..11]
    println(word.len())
    println(word == "xero")

    // a Vec through as_slice
    let mut v: Vec<i32> = Vec.new()
    for i in 0..10 {
        v.push(i)
    }
    println(sum(&v.as_slice()[5..]))
}
// output:
// 9
// 3
// 11
// 21
// 7
// 3
// 3
// 2
// 15
// 0
// hello
// xero
// 4
// true
// 35
