// Vec helpers that take closures.

struct Player {
    name: String
    score: i32
}

fn main() {
    let mut v: Vec<i32> = Vec.new()
    for x in [5, 3, 9, 1, 7, 2, 8] {
        v.push(x)
    }
    let doubled = v.map(|x| *x * 2)
    println(*doubled.at(2))
    let big = v.filter(|x| *x > 4)
    println(big.len())
    println(v.any(|x| *x == 9))
    println(v.all(|x| *x > 0))
    println(v.count(|x| *x % 2 == 1))
    println(v.position(|x| *x == 7))
    println(v.position(|x| *x == 100))

    let mut sum = 0
    v.for_each(|x| sum += *x)
    println(sum)

    v.sort()
    v.for_each(|x| print(*x))
    println("")

    v.sort_by(|a, b| b.cmp(a))
    v.for_each(|x| print(*x))
    println("")

    let mut players: Vec<Player> = Vec.new()
    players.push(Player { name: String.from("ana"), score: 30 })
    players.push(Player { name: String.from("bo"), score: 90 })
    players.push(Player { name: String.from("cy"), score: 60 })
    players.sort_by(|a, b| b.score.cmp(&a.score))
    let names = players.map(|p| p.score)
    println(*names.at(0))
    println(&players.at(0).name)
    println(&players.at(2).name)
}
// output:
// 18
// 4
// true
// true
// 5
// Some(4)
// None
// 35
// 1235789
// 9875321
// 90
// bo
// ana
