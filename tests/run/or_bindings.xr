// Bindings inside | patterns.

enum Shape {
    Circle(i32)
    Square(i32)
    Rect(i32, i32)
}

fn size(s: &Shape) -> i32 {
    match s {
        Shape.Circle(n) | Shape.Square(n) => *n
        Shape.Rect(w, h) => *w * *h
    }
}

fn main() {
    println(size(&Shape.Circle(3)))
    println(size(&Shape.Square(4)))
    println(size(&Shape.Rect(2, 5)))
    let r: Result<String, String> = Err(String.from("bad"))
    match r {
        Ok(s) | Err(s) => println(&s)
    }
    let t = (1, 7)
    match t {
        (0, x) | (x, 0) => println(x)
        (a, b) => println(a + b)
    }
}

// output:
// 3
// 4
// 10
// bad
// 8
