// impl Trait return types: returning closures and iterators.

fn adder(n: i32) -> impl Fn(i32) -> i32 {
    move |x| x + n
}

fn counter() -> impl FnMut() -> i32 {
    let mut c = 0
    move || {
        c += 1
        c
    }
}

fn evens(limit: i32) -> impl Iterator {
    (0..limit).filter(|x| *x % 2 == 0)
}

fn compose<F: Fn(i32) -> i32, G: Fn(i32) -> i32>(f: F, g: G) -> impl Fn(i32) -> i32 {
    move |x| g(f(x))
}

fn apply<F: Fn(i32) -> i32>(f: F, v: i32) -> i32 { f(v) }

fn main() {
    let add5 = adder(5)
    println(add5(10))
    println(apply(adder(1), 1))
    let mut c = counter()
    c()
    c()
    println(c())
    println(evens(10).count())
    let v: Vec<i32> = evens(7).collect()
    println(v[3])
    let h = compose(adder(2), |x| x * 10)
    println(h(1))
    let names: Vec<String> = Vec.new()
}

// output:
// 15
// 2
// 3
// 5
// 6
// 30
