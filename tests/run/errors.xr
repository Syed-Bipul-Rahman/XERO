// Error handling without exceptions: Result, try, throw, catch.

enum ParseError {
    Empty
    BadDigit(u8)
}

fn parse(s: &str) -> Result<i32, ParseError> {
    if s.len() == 0 {
        throw ParseError.Empty
    }
    let mut n = 0
    for b in s.as_bytes() {
        if *b < '0' || *b > '9' {
            throw ParseError.BadDigit(*b)
        }
        n = n * 10 + (*b - '0') as i32
    }
    Ok(n)
}

fn sum_two(a: &str, b: &str) -> Result<i32, ParseError> {
    let x = try parse(a)
    let y = try parse(b)
    Ok(x + y)
}

fn describe(r: Result<i32, ParseError>) {
    match r {
        Ok(v) => {
            print("ok: ")
            println(v)
        }
        Err(ParseError.Empty) => println("error: empty")
        Err(ParseError.BadDigit(c)) => {
            print("error: bad digit ")
            println(c)
        }
    }
}

fn first_even(v: &[i32]) -> Option<i32> {
    for x in v {
        if *x % 2 == 0 {
            return Some(*x)
        }
    }
    None
}

fn double_first_even(v: &[i32]) -> Option<i32> {
    let x = try first_even(v)
    Some(x * 2)
}

fn main() {
    describe(parse("123"))
    describe(parse(""))
    describe(parse("12x"))
    describe(sum_two("40", "2"))
    describe(sum_two("40", "z"))

    let v = parse("oops") catch e {
        println("recovered")
        -1
    }
    println(v)
    let w = parse("77") catch { 0 }
    println(w)

    println(double_first_even(&[1, 3, 4, 5]))
    println(double_first_even(&[1, 3]))
    let r = first_even(&[5, 6]).unwrap_or(0)
    println(r)
    if first_even(&[2]) is Some(x) {
        println(x)
    }
    let maybe: Option<i32> = None
    println(maybe.is_none())
}
// output:
// ok: 123
// error: empty
// error: bad digit 120
// ok: 42
// error: bad digit 122
// recovered
// -1
// 77
// Some(8)
// None
// 6
// 2
// true
