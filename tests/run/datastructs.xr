// Heap data structures with Box and Option; deterministic cleanup.

struct Node {
    value: i32
    next: Option<Box<Node>>
}

struct List {
    head: Option<Box<Node>>
    len: usize
}

impl List {
    fn new() -> List {
        List { head: None, len: 0 }
    }

    fn push_front(&mut self, value: i32) {
        let old = mem.replace(&mut self.head, None)
        self.head = Some(Box.new(Node { value: value, next: old }))
        self.len += 1
    }

    fn sum(&self) -> i32 {
        let mut total = 0
        let mut cur = &self.head
        while cur is Some(node) {
            total += node.get().value
            cur = &node.get().next
        }
        total
    }
}

import std.mem

// A binary search tree.
struct Tree {
    root: Option<Box<TreeNode>>
}

struct TreeNode {
    key: i32
    left: Option<Box<TreeNode>>
    right: Option<Box<TreeNode>>
}

fn insert(slot: &mut Option<Box<TreeNode>>, key: i32) {
    match slot {
        Some(node) => {
            let n = node.get_mut()
            if key < n.key {
                insert(&mut n.left, key)
            } else {
                insert(&mut n.right, key)
            }
        }
        None => {
            *slot = Some(Box.new(TreeNode { key: key, left: None, right: None }))
        }
    }
}

fn in_order(slot: &Option<Box<TreeNode>>, out: &mut Vec<i32>) {
    if slot is Some(node) {
        let n = node.get()
        in_order(&n.left, out)
        out.push(n.key)
        in_order(&n.right, out)
    }
}

fn main() {
    let mut list = List.new()
    for i in 1..=100 {
        list.push_front(i)
    }
    println(list.len)
    println(list.sum())

    let mut tree = Tree { root: None }
    let keys = [50, 30, 70, 20, 40, 60, 80, 35]
    for k in keys {
        insert(&mut tree.root, k)
    }
    let mut sorted: Vec<i32> = Vec.new()
    in_order(&tree.root, &mut sorted)
    for k in sorted.as_slice() {
        print(*k)
        print(" ")
    }
    println("")

    let mut s = String.new()
    s.push_str("xero ")
    s.push_int(2026)
    s.push_str("!")
    println(&s)
    println(s.len())
    println(s.equals("xero 2026!"))

    let mut words: Vec<String> = Vec.new()
    words.push(String.from("zero"))
    words.push(String.from("gc"))
    words.insert(0, String.from("no"))
    let removed = words.remove(1)
    println(&removed)
    println(words.len())
    println(words.at(1))
}
// output:
// 100
// 5050
// 20 30 35 40 50 60 70 80 
// xero 2026!
// 10
// true
// zero
// 2
// gc
