// Variables, arithmetic, control flow, functions.

fn fib(n: u64) -> u64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn sum_to(n: i32) -> i32 {
    let mut total = 0
    for i in 1..=n {
        total += i
    }
    total
}

fn classify(n: i32) -> &str {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

fn main() {
    let a = 7
    let b: i64 = 1_000_000_000_000
    println(a * 6)
    println(b * 3)
    println(fib(20))
    println(sum_to(100))
    println(classify(-5))
    println(classify(0))
    println(classify(9))

    let mut count = 0
    while count < 3 {
        count += 1
    }
    println(count)

    // loop as an expression
    let mut x = 1
    let first_big = loop {
        x *= 3
        if x > 100 {
            break x
        }
    }
    println(first_big)

    // break / continue
    let mut evens = 0
    for i in 0..10 {
        if i % 2 == 1 {
            continue
        }
        if i == 8 {
            break
        }
        evens += 1
    }
    println(evens)

    // casts and floats
    let f = 3.5
    println(f * 2.0)
    println((f as i32) + 1)
    println(255u8 as i32 + 1)
    println(-1 as i64)
    println(10 / 3)
    println(-7 % 3)
    println(1 << 10)
    println(true && !false)
    println(0xFF & 0x0F)
}
// output:
// 42
// 3000000000000
// 6765
// 5050
// negative
// zero
// positive
// 3
// 243
// 4
// 7.0
// 4
// 256
// -1
// 3
// -1
// 1024
// true
// 15
