trait Named { fn name(&self) -> &str }
struct P { n: String }
impl Named for P { fn name(&self) -> &str { self.n.as_str() } }
fn main() {
    let mut r: &str = "init"
    {
        let p = P { n: String.from("x") }
        let d: &dyn Named = &p
        r = d.name()
    }
    println(r)
}
// error: `p` does not live long enough: it is still borrowed by `r` after its scope ends
