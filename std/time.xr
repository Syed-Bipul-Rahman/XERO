// Time: `Duration`, `Instant` for measuring, `sleep`, and the wall clock.
//
//   let start = Instant.now()
//   work()
//   println("took {} ms", start.elapsed().as_millis())

module std.time

import std.sys

/// A span of time, to the nanosecond.
pub copy struct Duration {
    nanos: u64
}

impl Duration {
    pub fn from_secs(s: u64) -> Duration {
        Duration { nanos: s * 1000000000 }
    }

    pub fn from_millis(ms: u64) -> Duration {
        Duration { nanos: ms * 1000000 }
    }

    pub fn from_micros(us: u64) -> Duration {
        Duration { nanos: us * 1000 }
    }

    pub fn from_nanos(ns: u64) -> Duration {
        Duration { nanos: ns }
    }

    /// From a number of seconds such as `1.5`; negative values give zero.
    pub fn from_secs_f64(s: f64) -> Duration {
        if s <= 0.0 {
            return Duration { nanos: 0 }
        }
        Duration { nanos: (s * 1000000000.0) as u64 }
    }

    pub fn zero() -> Duration {
        Duration { nanos: 0 }
    }

    /// Whole seconds.
    pub fn as_secs(&self) -> u64 {
        self.nanos / 1000000000
    }

    pub fn as_millis(&self) -> u64 {
        self.nanos / 1000000
    }

    pub fn as_micros(&self) -> u64 {
        self.nanos / 1000
    }

    pub fn as_nanos(&self) -> u64 {
        self.nanos
    }

    pub fn as_secs_f64(&self) -> f64 {
        (self.nanos as f64) / 1000000000.0
    }

    /// The nanoseconds past the whole seconds.
    pub fn subsec_nanos(&self) -> u32 {
        (self.nanos % 1000000000) as u32
    }

    pub fn is_zero(&self) -> bool {
        self.nanos == 0
    }

    /// `self - other`, or zero if `other` is longer.
    pub fn saturating_sub(&self, other: Duration) -> Duration {
        if other.nanos >= self.nanos { Duration { nanos: 0 } } else { Duration { nanos: self.nanos - other.nanos } }
    }
}

impl Add for Duration {
    type Output = Duration
    fn add(self, o: Duration) -> Duration {
        Duration { nanos: self.nanos + o.nanos }
    }
}

impl Sub for Duration {
    type Output = Duration
    fn sub(self, o: Duration) -> Duration {
        Duration { nanos: self.nanos - o.nanos }
    }
}

impl Mul<u64> for Duration {
    type Output = Duration
    fn mul(self, n: u64) -> Duration {
        Duration { nanos: self.nanos * n }
    }
}

impl Div<u64> for Duration {
    type Output = Duration
    fn div(self, n: u64) -> Duration {
        Duration { nanos: self.nanos / n }
    }
}

impl AddAssign for Duration {
    fn add_assign(&mut self, o: Duration) {
        self.nanos += o.nanos
    }
}

impl SubAssign for Duration {
    fn sub_assign(&mut self, o: Duration) {
        self.nanos -= o.nanos
    }
}

impl Eq for Duration {
    fn eq(&self, o: &Duration) -> bool {
        self.nanos == o.nanos
    }
}

impl Ord for Duration {
    fn cmp(&self, o: &Duration) -> Ordering {
        self.nanos.cmp(&o.nanos)
    }
}

impl Hash for Duration {
    fn hash(&self, h: &mut Hasher) {
        self.nanos.hash(h)
    }
}

/// Written in the largest unit that keeps it readable: `1.5s`, `250ms`,
/// `12.5us`, `80ns`.
impl Display for Duration {
    fn fmt(&self, out: &mut String) {
        let n = self.nanos
        if n >= 1000000000 {
            unit(out, n, 1000000000, "s")
        } else if n >= 1000000 {
            unit(out, n, 1000000, "ms")
        } else if n >= 1000 {
            unit(out, n, 1000, "us")
        } else {
            n.fmt(out)
            out.push_str("ns")
        }
    }
}

/// `n / per` with up to three decimals (trailing zeros dropped).
fn unit(out: &mut String, n: u64, per: u64, name: &str) {
    (n / per).fmt(out)
    let mut frac = (n % per) * 1000 / per
    if frac != 0 {
        out.push_byte('.')
        let mut digits: u32 = 3
        while frac % 10 == 0 {
            frac /= 10
            digits -= 1
        }
        let mut scale: u64 = 1
        for _ in 1..digits {
            scale *= 10
        }
        while scale > 0 {
            out.push_byte(('0' as u64 + (frac / scale) % 10) as u8)
            scale /= 10
        }
    }
    out.push_str(name)
}

impl Print for Duration {
    fn write_to(&self, fd: i32) {
        let mut s = String.new()
        self.fmt(&mut s)
        write_str(fd, s.as_str())
    }
}

/// A point in time on a clock that never goes back, for measuring how
/// long something takes.
pub copy struct Instant {
    nanos: u64
}

impl Instant {
    pub fn now() -> Instant {
        Instant { nanos: sys.clock_monotonic() }
    }

    /// The time since this instant.
    pub fn elapsed(&self) -> Duration {
        Instant.now().duration_since(*self)
    }

    /// The time from `earlier` to this instant (zero if `earlier` is later).
    pub fn duration_since(&self, earlier: Instant) -> Duration {
        if earlier.nanos >= self.nanos {
            Duration { nanos: 0 }
        } else {
            Duration { nanos: self.nanos - earlier.nanos }
        }
    }
}

impl Add<Duration> for Instant {
    type Output = Instant
    fn add(self, d: Duration) -> Instant {
        Instant { nanos: self.nanos + d.nanos }
    }
}

impl Sub for Instant {
    type Output = Duration
    fn sub(self, o: Instant) -> Duration {
        self.duration_since(o)
    }
}

impl Eq for Instant {
    fn eq(&self, o: &Instant) -> bool {
        self.nanos == o.nanos
    }
}

impl Ord for Instant {
    fn cmp(&self, o: &Instant) -> Ordering {
        self.nanos.cmp(&o.nanos)
    }
}

/// Block this thread for `d`.
pub fn sleep(d: Duration) {
    if d.nanos > 0 {
        sys.sleep_ns(d.nanos)
    }
}

/// The wall-clock time as a duration since 1970-01-01 00:00 UTC (the
/// Unix epoch). Unlike `Instant`, it can jump when the clock is set.
pub fn since_epoch() -> Duration {
    Duration { nanos: sys.clock_realtime() }
}

/// A future that is ready after `d`: `sleep_async(Duration.from_millis(10)).await`.
/// Other tasks run meanwhile; a helper thread wakes the task when the time is up.
pub fn sleep_async(d: Duration) -> Sleep {
    Sleep { deadline: Instant.now() + d, timer: 0, started: false }
}

pub struct Sleep {
    deadline: Instant
    /// The timer thread, once started.
    timer: usize
    started: bool
}

/// What the timer thread gets: when to wake, and whom.
struct Timer {
    deadline: Instant
    waker: Waker
}

fn timer_main(p: *u8) -> *u8 {
    unsafe {
        let t = p as *Timer
        let now = Instant.now()
        let wait = (*t).deadline.duration_since(now)
        sleep(wait)
        (*t).waker.wake()
        sys.heap_free(p)
    }
    0 as *u8
}

impl Future for Sleep {
    type Output = ()
    unsafe fn poll(&mut self, cx: &mut Context) -> Poll<()> {
        if Instant.now() >= self.deadline {
            self.join_timer()
            return Poll.Ready(())
        }
        if !self.started {
            if !sys.THREADS {
                // nothing can wake us: wait here
                sleep(self.deadline.duration_since(Instant.now()))
                return Poll.Ready(())
            }
            let t = sys.heap_alloc(32) as *Timer
            *t = Timer { deadline: self.deadline, waker: cx.waker() }
            self.timer = sys.thread_start(timer_main, t as *u8)
            self.started = true
        }
        Poll.Pending
    }
}

impl Sleep {
    fn join_timer(&mut self) {
        if self.started {
            unsafe { sys.thread_join(self.timer) }
            self.started = false
        }
    }

    drop {
        self.join_timer()
    }
}
