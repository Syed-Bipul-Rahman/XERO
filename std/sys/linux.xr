// OS layer for Linux without the C library: Xero's own runtime.
//
// Programs talk to the kernel directly with system calls. This file provides
// the heap (an mmap-based allocator), threads (`clone`), locks and condition
// variables (futexes), and the few C-named functions that LLVM itself may
// call (`memcpy`, `memmove`, `memset`, `memcmp`, `bcmp`, `fmod`, `fmodf`).
// The program entry point `_start` is emitted by the compiler.
//
// The compiler picks this file as `std.sys` for Linux targets unless the
// program uses the C library (`--libc`, or C functions it declares).

module std.sys

import std.sys.target

// ------------------------------------------------- processes, files, memory
// File functions return a negative error code (`-errno`) on failure.

const AT_FDCWD: i32 = -100
const NO_FD: i32 = -1

pub unsafe fn fd_write(fd: i32, buf: *u8, count: usize) -> isize {
    syscall(target.SYS_WRITE, fd, buf, count)
}

pub unsafe fn fd_read(fd: i32, buf: *u8, count: usize) -> isize {
    syscall(target.SYS_READ, fd, buf, count)
}

/// Open the NUL-terminated `path`: mode 0 reads, 1 writes (creating or
/// truncating the file) and 2 appends (creating it if needed).
pub unsafe fn fd_open(path: *u8, mode: i32) -> i32 {
    let flags = if mode == 0 {
        target.O_RDONLY
    } else if mode == 1 {
        target.O_WRONLY | target.O_CREAT | target.O_TRUNC
    } else {
        target.O_WRONLY | target.O_CREAT | target.O_APPEND
    }
    syscall(target.SYS_OPENAT, AT_FDCWD, path, flags | target.O_CLOEXEC, 420) as i32
}

pub unsafe fn fd_close(fd: i32) {
    syscall(target.SYS_CLOSE, fd)
}

pub fn exit_process(code: i32) -> ! {
    unsafe {
        syscall(target.SYS_EXIT_GROUP, code)
        trap()
    }
}

pub fn abort_process() -> ! {
    unsafe {
        let pid = syscall(target.SYS_GETPID)
        let tid = syscall(target.SYS_GETTID)
        syscall(target.SYS_TGKILL, pid, tid, 6)
        // SIGABRT was blocked or handled: exit as the shell reports an abort
        syscall(target.SYS_EXIT_GROUP, 134)
        trap()
    }
}

// ------------------------------------------------------------- the heap
//
// Every block starts with a 16-byte header; the caller's memory follows it,
// 16-byte aligned. Small blocks are powers of two from 32 bytes to 64 KiB,
// carved out of 1 MiB regions and recycled through free lists, one per size.
// Larger blocks get their own mapping; growing one uses `mremap`, so a large
// `Vec` grows without copying.
//
// The small-block heap is split into arenas, each with its own lock, so
// threads rarely wait for each other: a thread uses the arena picked by the
// address of its stack, and a freed block goes back to the arena it came
// from. Until the program starts a thread, no locks are taken at all.
//
// Header word 0: the size class and arena (`class | arena << 8`, below
// `PAGE`) for small blocks, or the mapping length (a multiple of `PAGE`) for
// large ones. A freed small block keeps the next free block in word 1.

const HEADER: usize = 16
const MIN_CLASS: usize = 5
const MAX_CLASS: usize = 16
const REGION: usize = 1048576
const PAGE: usize = 4096
const ARENAS: usize = 8
// one arena's words: 0 lock, 1 region cursor, 2 region end, 3.. free lists
// (32 words, so arenas do not share cache lines)
const ARENA_WORDS: usize = 32
const FREE_LISTS: usize = 3

static mut HEAP: [usize; 256] = [0; 256]
// no locking is needed until the program starts its first thread
static mut THREADED: bool = false

const PROT_NONE: usize = 0
const PROT_RW: usize = 3
const MAP_PRIVATE_ANON: usize = 0x22
const MAP_STACK: usize = 0x20000
const MREMAP_MAYMOVE: usize = 1

/// Map `len` bytes of zeroed memory; returns 0 on failure.
unsafe fn map(len: usize, extra_flags: usize) -> usize {
    let r = syscall(target.SYS_MMAP, 0, len, PROT_RW, MAP_PRIVATE_ANON | extra_flags, NO_FD, 0)
    if r < 0 && r > -4096 { 0 } else { r as usize }
}

unsafe fn unmap(addr: usize, len: usize) {
    syscall(target.SYS_MUNMAP, addr, len)
}

fn round_up(n: usize, to: usize) -> usize {
    (n + to - 1) & (0 - to)
}

/// The smallest size class whose blocks hold `size` bytes after the header.
fn class_of(size: usize) -> usize {
    let mut k = MIN_CLASS
    while ((1 as usize) << k) - HEADER < size {
        k += 1
    }
    k
}

/// The arena for the calling thread: thread stacks are separate 8 MiB
/// mappings, so the address of a local tells threads apart.
fn my_arena() -> usize {
    let marker: u8 = 0
    ((&marker as *u8 as usize) >> 23) % ARENAS
}

unsafe fn arena_ptr(a: usize) -> *usize {
    (&mut HEAP as *usize) + a * ARENA_WORDS
}

/// Returns null when out of memory.
pub unsafe fn heap_alloc(size: usize) -> *u8 {
    if size > ((1 as usize) << MAX_CLASS) - HEADER {
        let len = round_up(size + HEADER, PAGE)
        let b = map(len, 0)
        if b == 0 {
            return 0 as *u8
        }
        *(b as *usize) = len
        return (b + HEADER) as *u8
    }
    let k = class_of(size)
    let a = my_arena()
    let ar = arena_ptr(a)
    let threaded = THREADED
    if threaded {
        raw_lock(ar as *u32)
    }
    let mut b = *(ar + FREE_LISTS + k)
    if b != 0 {
        *(ar + FREE_LISTS + k) = *((b + 8) as *usize)
    } else {
        let bsize = (1 as usize) << k
        if *(ar + 1) + bsize > *(ar + 2) {
            let r = map(REGION, 0)
            if r == 0 {
                if threaded {
                    raw_unlock(ar as *u32)
                }
                return 0 as *u8
            }
            *(ar + 1) = r
            *(ar + 2) = r + REGION
        }
        b = *(ar + 1)
        *(ar + 1) = b + bsize
    }
    if threaded {
        raw_unlock(ar as *u32)
    }
    *(b as *usize) = k | (a << 8)
    (b + HEADER) as *u8
}

pub unsafe fn heap_free(ptr: *u8) {
    if ptr as usize == 0 {
        return
    }
    let b = ptr as usize - HEADER
    let w = *(b as *usize)
    if w >= PAGE {
        unmap(b, w)
        return
    }
    let k = w & 255
    let ar = arena_ptr(w >> 8)
    let threaded = THREADED
    if threaded {
        raw_lock(ar as *u32)
    }
    *((b + 8) as *usize) = *(ar + FREE_LISTS + k)
    *(ar + FREE_LISTS + k) = b
    if threaded {
        raw_unlock(ar as *u32)
    }
}

/// Usable bytes in the block holding `ptr`.
unsafe fn capacity(ptr: *u8) -> usize {
    let w = *((ptr as usize - HEADER) as *usize)
    if w >= PAGE { w - HEADER } else { ((1 as usize) << (w & 255)) - HEADER }
}

pub unsafe fn heap_realloc(ptr: *u8, size: usize) -> *u8 {
    if ptr as usize == 0 {
        return heap_alloc(size)
    }
    let cap = capacity(ptr)
    let b = ptr as usize - HEADER
    let k = *(b as *usize)
    let large = k >= PAGE
    if large && size > ((1 as usize) << MAX_CLASS) - HEADER {
        // a large block stays large: let the kernel move its pages
        let len = round_up(size + HEADER, PAGE)
        if len == k {
            return ptr
        }
        let r = syscall(target.SYS_MREMAP, b, k, len, MREMAP_MAYMOVE)
        if r < 0 && r > -4096 {
            return 0 as *u8
        }
        *(r as *usize) = len
        return (r as usize + HEADER) as *u8
    }
    if size <= cap && (large || size * 4 >= cap) {
        return ptr
    }
    let n = heap_alloc(size)
    if n as usize == 0 {
        return n
    }
    copy_bytes(n, ptr, if size < cap { size } else { cap })
    heap_free(ptr)
    n
}

/// Copy `count` bytes; the regions may overlap.
pub unsafe fn mem_move(dst: *u8, src: *u8, count: usize) {
    memmove(dst, src, count)
}

/// Forward copy, a word at a time when both pointers allow it.
unsafe fn copy_bytes(dst: *u8, src: *u8, count: usize) {
    let mut i: usize = 0
    if (dst as usize | src as usize) & 7 == 0 {
        while i + 8 <= count {
            *((dst + i) as *u64) = *((src + i) as *u64)
            i += 8
        }
    }
    while i < count {
        *(dst + i) = *(src + i)
        i += 1
    }
}

// Functions LLVM may call for copies, comparisons and `%` on floats.

export unsafe fn memcpy(dst: *u8, src: *u8, count: usize) -> *u8 {
    copy_bytes(dst, src, count)
    dst
}

export unsafe fn memmove(dst: *u8, src: *u8, count: usize) -> *u8 {
    if dst as usize <= src as usize || dst as usize >= src as usize + count {
        copy_bytes(dst, src, count)
        return dst
    }
    // overlapping with dst after src: copy backwards
    let mut i = count
    if (dst as usize | src as usize | count) & 7 == 0 {
        while i >= 8 {
            i -= 8
            *((dst + i) as *u64) = *((src + i) as *u64)
        }
    }
    while i > 0 {
        i -= 1
        *(dst + i) = *(src + i)
    }
    dst
}

export unsafe fn memset(dst: *u8, value: i32, count: usize) -> *u8 {
    let byte = value as u8
    let mut i: usize = 0
    if dst as usize & 7 == 0 {
        let word = (byte as u64) * 0x0101010101010101
        while i + 8 <= count {
            *((dst + i) as *u64) = word
            i += 8
        }
    }
    while i < count {
        *(dst + i) = byte
        i += 1
    }
    dst
}

export unsafe fn memcmp(a: *u8, b: *u8, count: usize) -> i32 {
    let mut i: usize = 0
    while i < count {
        let x = *(a + i)
        let y = *(b + i)
        if x != y {
            return x as i32 - y as i32
        }
        i += 1
    }
    0
}

export unsafe fn bcmp(a: *u8, b: *u8, count: usize) -> i32 {
    memcmp(a, b, count)
}

unsafe fn f64_bits(x: f64) -> u64 {
    let v = x
    *((&v as *f64) as *u64)
}

unsafe fn f64_from(bits: u64) -> f64 {
    let v = bits
    *((&v as *u64) as *f64)
}

/// The remainder of `x / y` with the sign of `x`, computed exactly.
export fn fmod(x: f64, y: f64) -> f64 {
    unsafe {
        let mut ux = f64_bits(x)
        let mut uy = f64_bits(y)
        let mut ex = ((ux >> 52) & 0x7ff) as i64
        let mut ey = ((uy >> 52) & 0x7ff) as i64
        let sign = ux & 0x8000000000000000
        if (uy << 1) == 0 || ex == 0x7ff || y != y {
            return (x * y) / (x * y)
        }
        if (ux << 1) <= (uy << 1) {
            if (ux << 1) == (uy << 1) {
                return 0.0 * x
            }
            return x
        }
        // normalize both mantissas, with the implicit bit
        if ex == 0 {
            let mut i = ux << 12
            while i >> 63 == 0 {
                ex -= 1
                i <<= 1
            }
            ux <<= (1 - ex) as u64
        } else {
            ux &= 0xFFFFFFFFFFFFF
            ux |= 0x10000000000000
        }
        if ey == 0 {
            let mut i = uy << 12
            while i >> 63 == 0 {
                ey -= 1
                i <<= 1
            }
            uy <<= (1 - ey) as u64
        } else {
            uy &= 0xFFFFFFFFFFFFF
            uy |= 0x10000000000000
        }
        // shift-and-subtract, one bit of the quotient at a time
        while ex > ey {
            if ux >= uy {
                ux -= uy
                if ux == 0 {
                    return 0.0 * x
                }
            }
            ux <<= 1
            ex -= 1
        }
        if ux >= uy {
            ux -= uy
            if ux == 0 {
                return 0.0 * x
            }
        }
        while ux >> 52 == 0 {
            ux <<= 1
            ex -= 1
        }
        if ex > 0 {
            ux -= 0x10000000000000
            ux |= (ex as u64) << 52
        } else {
            ux >>= (1 - ex) as u64
        }
        f64_from(ux | sign)
    }
}

export fn fmodf(x: f32, y: f32) -> f32 {
    // every f32 is exactly an f64, and the remainder is exact
    fmod(x as f64, y as f64) as f32
}

// ------------------------------------------------- futexes and threads

const FUTEX_WAIT: usize = 0
const FUTEX_WAKE: usize = 1
const FUTEX_PRIVATE: usize = 128

unsafe fn futex_wait(addr: *u32, value: u32, process_private: bool) {
    syscall(target.SYS_FUTEX, addr, if process_private { FUTEX_WAIT | FUTEX_PRIVATE } else { FUTEX_WAIT }, value, 0)
}

unsafe fn futex_wake(addr: *u32, count: u32) {
    syscall(target.SYS_FUTEX, addr, FUTEX_WAKE | FUTEX_PRIVATE, count)
}

// A lock is one word: 0 unlocked, 1 locked, 2 locked with waiters.

unsafe fn raw_lock(m: *u32) {
    let mut c = atomic_cas(m, 0, 1)
    if c == 0 {
        return
    }
    // locks are held briefly: spin a little before sleeping in the kernel
    let mut spins = 0
    while spins < 100 {
        if atomic_load(m) == 0 {
            c = atomic_cas(m, 0, 1)
            if c == 0 {
                return
            }
        }
        spins += 1
    }
    if c != 2 {
        c = atomic_swap(m, 2)
    }
    while c != 0 {
        futex_wait(m, 2, true)
        c = atomic_swap(m, 2)
    }
}

unsafe fn raw_unlock(m: *u32) {
    if atomic_swap(m, 0) == 2 {
        futex_wake(m, 1)
    }
}

pub const THREADS: bool = true

const STACK_SIZE: usize = 8388608
// CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD |
// CLONE_SYSVSEM | CLONE_PARENT_SETTID | CLONE_CHILD_CLEARTID
const CLONE_FLAGS: usize = 0x350F00

unsafe fn __xero_clone(entry: fn(*u8) -> *u8, stack: *u8, flags: usize, arg: *u8, ptid: *u32, tls: usize, ctid: *u32) -> isize

/// A running thread: the kernel clears `tid` (and wakes waiters) when the
/// thread exits, after which its stack can be unmapped.
struct ThreadBlock {
    tid: u32
    stack: usize
}

/// Start a thread running `entry(arg)`; returns its handle.
pub unsafe fn thread_start(entry: fn(*u8) -> *u8, arg: *u8) -> usize {
    // from now on the heap takes its lock (this thread is the only one
    // running, so the plain store is seen by every thread started later)
    THREADED = true
    let stack = map(STACK_SIZE, MAP_STACK)
    if stack == 0 {
        panic("could not start a thread: out of memory")
    }
    // a guard page below the stack turns an overflow into a crash
    syscall(target.SYS_MPROTECT, stack, PAGE, PROT_NONE)
    let tb = heap_alloc(size_of<ThreadBlock>()) as *ThreadBlock
    if tb as usize == 0 {
        panic("could not start a thread: out of memory")
    }
    ptr_write(tb, ThreadBlock { tid: 0, stack: stack })
    let tid = &mut (*tb).tid as *u32
    let r = __xero_clone(entry, (stack + STACK_SIZE) as *u8, CLONE_FLAGS, arg, tid, 0, tid)
    if r < 0 {
        panic("could not start a thread")
    }
    tb as usize
}

/// Wait for a thread to finish.
pub unsafe fn thread_join(t: usize) {
    let tb = t as *ThreadBlock
    let tid = &mut (*tb).tid as *u32
    loop {
        let v = atomic_load(tid)
        if v == 0 {
            break
        }
        // the kernel's wake on thread exit is not process-private
        futex_wait(tid, v, false)
    }
    unmap((*tb).stack, STACK_SIZE)
    heap_free(tb as *u8)
}

pub unsafe fn lock_new() -> *u8 {
    let m = heap_alloc(8)
    if m as usize == 0 {
        panic("out of memory")
    }
    *(m as *u32) = 0
    m
}

pub unsafe fn lock_acquire(m: *u8) {
    raw_lock(m as *u32)
}

pub unsafe fn lock_release(m: *u8) {
    raw_unlock(m as *u32)
}

pub unsafe fn lock_free(m: *u8) {
    heap_free(m)
}

// A condition variable is two words: a sequence number, bumped by every
// notification, and the number of waiting threads (so that notifying
// nobody costs no system call).

pub unsafe fn cond_new() -> *u8 {
    let c = heap_alloc(8)
    if c as usize == 0 {
        panic("out of memory")
    }
    *(c as *u64) = 0
    c
}

/// Atomically release `m`, wait for a notification, and re-acquire `m`.
pub unsafe fn cond_wait(c: *u8, m: *u8) {
    let seq = c as *u32
    let waiters = seq + 1
    // both happen while `m` is held, so a notifier (which changes the
    // condition under `m`) sees this waiter and changes `seq` afterwards
    atomic_add(waiters, 1)
    let s = atomic_load(seq)
    raw_unlock(m as *u32)
    futex_wait(seq, s, true)
    atomic_sub(waiters, 1)
    raw_lock(m as *u32)
}

pub unsafe fn cond_notify_one(c: *u8) {
    let seq = c as *u32
    atomic_add(seq, 1)
    if atomic_load(seq + 1) != 0 {
        futex_wake(seq, 1)
    }
}

pub unsafe fn cond_notify_all(c: *u8) {
    let seq = c as *u32
    atomic_add(seq, 1)
    if atomic_load(seq + 1) != 0 {
        futex_wake(seq, 0x7FFFFFFF)
    }
}

pub unsafe fn cond_free(c: *u8) {
    heap_free(c)
}

pub fn sleep_ms(ms: u64) {
    let ts = [(ms / 1000) as i64, ((ms % 1000) * 1000000) as i64]
    unsafe {
        syscall(target.SYS_NANOSLEEP, &ts as *i64, 0)
    }
}

pub fn yield_now() {
    unsafe {
        syscall(target.SYS_SCHED_YIELD)
    }
}
