// A growable, heap-allocated array.

module std.vec

import std.mem

pub struct Vec<T> {
    ptr: *T
    len: usize
    cap: usize
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec { ptr: 0 as *T, len: 0, cap: 0 }
    }

    pub fn with_capacity(capacity: usize) -> Vec<T> {
        if capacity == 0 {
            return Vec.new()
        }
        unsafe { Vec { ptr: mem.alloc<T>(capacity), len: 0, cap: capacity } }
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn capacity(&self) -> usize {
        self.cap
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    fn grow(&mut self) {
        let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 }
        unsafe {
            if self.cap == 0 {
                self.ptr = mem.alloc<T>(new_cap)
            } else {
                self.ptr = mem.realloc_array(self.ptr, new_cap)
            }
        }
        self.cap = new_cap
    }

    pub fn reserve(&mut self, additional: usize) {
        while self.cap - self.len < additional {
            self.grow()
        }
    }

    pub fn push(&mut self, value: T) {
        if self.len == self.cap {
            self.grow()
        }
        unsafe { ptr_write(self.ptr + self.len, value) }
        self.len += 1
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        unsafe { Some(ptr_read(self.ptr + self.len)) }
    }

    /// Bounds-checked access; `None` when out of range.
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len {
            return None
        }
        unsafe { Some(&*(self.ptr + index)) }
    }

    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        if index >= self.len {
            return None
        }
        unsafe { Some(&mut *(self.ptr + index)) }
    }

    /// Reference to element `index`; panics when out of range.
    pub fn at(&self, index: usize) -> &T {
        if index >= self.len {
            panic("Vec index out of bounds")
        }
        unsafe { &*(self.ptr + index) }
    }

    pub fn at_mut(&mut self, index: usize) -> &mut T {
        if index >= self.len {
            panic("Vec index out of bounds")
        }
        unsafe { &mut *(self.ptr + index) }
    }

    /// Replace element `index`, dropping the old value.
    pub fn set(&mut self, index: usize, value: T) {
        if index >= self.len {
            panic("Vec index out of bounds")
        }
        unsafe { *(self.ptr + index) = value }
    }

    pub fn swap(&mut self, a: usize, b: usize) {
        if a >= self.len || b >= self.len {
            panic("Vec index out of bounds")
        }
        if a != b {
            unsafe {
                let pa = self.ptr + a
                let pb = self.ptr + b
                let tmp = ptr_read(pa)
                ptr_write(pa, ptr_read(pb))
                ptr_write(pb, tmp)
            }
        }
    }

    pub fn as_slice(&self) -> &[T] {
        if self.len == 0 {
            return unsafe { slice_from_raw(self.ptr, 0) }
        }
        unsafe { slice_from_raw(self.ptr, self.len) }
    }

    pub fn as_mut_slice(&mut self) -> &mut [T] {
        unsafe { slice_from_raw_mut(self.ptr, self.len) }
    }

    pub fn clear(&mut self) {
        while self.len > 0 {
            self.len -= 1
            unsafe { drop_in_place(self.ptr + self.len) }
        }
    }

    pub fn insert(&mut self, index: usize, value: T) {
        if index > self.len {
            panic("Vec insert index out of bounds")
        }
        if self.len == self.cap {
            self.grow()
        }
        unsafe {
            mem.copy_values(self.ptr + index, self.ptr + index + 1, self.len - index)
            ptr_write(self.ptr + index, value)
        }
        self.len += 1
    }

    pub fn remove(&mut self, index: usize) -> T {
        if index >= self.len {
            panic("Vec remove index out of bounds")
        }
        unsafe {
            let value = ptr_read(self.ptr + index)
            mem.copy_values(self.ptr + index + 1, self.ptr + index, self.len - index - 1)
            self.len -= 1
            value
        }
    }

    // ---------------------------------------------------- with closures

    /// Call `f` on each element in order.
    pub fn for_each<F: FnMut(&T)>(&self, mut f: F) {
        for x in self.as_slice() {
            f(x)
        }
    }

    /// A new vector with `f` applied to each element.
    pub fn map<U, F: Fn(&T) -> U>(&self, f: F) -> Vec<U> {
        let mut out: Vec<U> = Vec.with_capacity(self.len)
        for x in self.as_slice() {
            out.push(f(x))
        }
        out
    }

    /// A new vector with the elements for which `keep` is true
    /// (for element types that can be copied).
    pub fn filter<F: Fn(&T) -> bool>(&self, keep: F) -> Vec<T> {
        let mut out: Vec<T> = Vec.new()
        for x in self.as_slice() {
            if keep(x) {
                out.push(*x)
            }
        }
        out
    }

    pub fn any<F: Fn(&T) -> bool>(&self, f: F) -> bool {
        for x in self.as_slice() {
            if f(x) {
                return true
            }
        }
        false
    }

    pub fn all<F: Fn(&T) -> bool>(&self, f: F) -> bool {
        for x in self.as_slice() {
            if !f(x) {
                return false
            }
        }
        true
    }

    /// How many elements satisfy `f`.
    pub fn count<F: Fn(&T) -> bool>(&self, f: F) -> usize {
        let mut n: usize = 0
        for x in self.as_slice() {
            if f(x) {
                n += 1
            }
        }
        n
    }

    /// Index of the first element satisfying `f`.
    pub fn position<F: Fn(&T) -> bool>(&self, f: F) -> Option<usize> {
        let mut i: usize = 0
        while i < self.len {
            if f(self.at(i)) {
                return Some(i)
            }
            i += 1
        }
        None
    }

    /// Sort in place by `cmp` (heap sort: O(n log n), no allocation, not stable).
    pub fn sort_by<F: Fn(&T, &T) -> Ordering>(&mut self, cmp: F) {
        let n = self.len
        if n < 2 {
            return
        }
        let mut start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down(start, n, &cmp)
        }
        let mut end = n
        while end > 1 {
            end -= 1
            self.swap(0, end)
            self.sift_down(0, end, &cmp)
        }
    }

    fn sift_down<F: Fn(&T, &T) -> Ordering>(&mut self, start: usize, end: usize, cmp: &F) {
        let mut root = start
        loop {
            let mut child = 2 * root + 1
            if child >= end {
                return
            }
            if child + 1 < end && cmp(self.at(child), self.at(child + 1)) is Ordering.Less {
                child += 1
            }
            if cmp(self.at(root), self.at(child)) is Ordering.Less {
                self.swap(root, child)
                root = child
            } else {
                return
            }
        }
    }

    /// Sort in place, for element types that implement `Ord`.
    pub fn sort(&mut self) {
        self.sort_by(|a, b| a.cmp(b))
    }

    drop {
        self.clear()
        if self.cap > 0 {
            unsafe { mem.dealloc(self.ptr) }
        }
    }
}
