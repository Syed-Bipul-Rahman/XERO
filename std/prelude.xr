// The Xero prelude: imported into every module automatically.
//
// Everything here is ordinary Xero code. Generic functions are instantiated
// only when used, so a program that never prints never links `write`.

module std.prelude

import std.sys

// ------------------------------------------------------------ Option

pub copy enum Option<T> {
    Some(T)
    None
}

impl<T> Option<T> {
    pub fn is_some(&self) -> bool {
        match self {
            Some(_) => true
            None => false
        }
    }

    pub fn is_none(&self) -> bool {
        !self.is_some()
    }

    pub fn unwrap(self) -> T {
        match self {
            Some(value) => value
            None => panic("called `unwrap` on a `None` value")
        }
    }

    pub fn expect(self, message: &str) -> T {
        match self {
            Some(value) => value
            None => panic(message)
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(value) => value
            None => default
        }
    }

    pub fn ok_or<E>(self, error: E) -> Result<T, E> {
        match self {
            Some(value) => Ok(value)
            None => Err(error)
        }
    }
}

// ------------------------------------------------------------ Result

pub copy enum Result<T, E> {
    Ok(T)
    Err(E)
}

impl<T, E> Result<T, E> {
    pub fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }

    pub fn is_err(&self) -> bool {
        !self.is_ok()
    }

    pub fn unwrap(self) -> T {
        match self {
            Ok(value) => value
            Err(_) => panic("called `unwrap` on an `Err` value")
        }
    }

    pub fn expect(self, message: &str) -> T {
        match self {
            Ok(value) => value
            Err(_) => panic(message)
        }
    }

    pub fn unwrap_err(self) -> E {
        match self {
            Ok(_) => panic("called `unwrap_err` on an `Ok` value")
            Err(error) => error
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(value) => value
            Err(_) => default
        }
    }

    pub fn ok(self) -> Option<T> {
        match self {
            Ok(value) => Some(value)
            Err(_) => None
        }
    }

    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => None
            Err(error) => Some(error)
        }
    }
}

// ------------------------------------------------------------ operators
//
// Operators on your own types call these traits, dispatched statically:
//   a == b, a != b        Eq.eq / Eq.ne      (operands are borrowed)
//   a < b, <=, >, >=      Ord.lt / le / gt / ge, all derived from `cmp`
//   a + b, -, *, /, %     Add.add, Sub.sub, Mul.mul, Div.div, Rem.rem (moved)
//   -a                    Neg.neg
// Built-in numbers, bool and pointers never go through them.

pub copy enum Ordering {
    Less
    Equal
    Greater
}

pub trait Eq {
    fn eq(&self, other: &Self) -> bool

    fn ne(&self, other: &Self) -> bool {
        !self.eq(other)
    }
}

pub trait Ord extends Eq {
    fn cmp(&self, other: &Self) -> Ordering

    fn lt(&self, other: &Self) -> bool {
        match self.cmp(other) {
            Ordering.Less => true
            _ => false
        }
    }

    fn le(&self, other: &Self) -> bool {
        match self.cmp(other) {
            Ordering.Greater => false
            _ => true
        }
    }

    fn gt(&self, other: &Self) -> bool {
        match self.cmp(other) {
            Ordering.Greater => true
            _ => false
        }
    }

    fn ge(&self, other: &Self) -> bool {
        match self.cmp(other) {
            Ordering.Less => false
            _ => true
        }
    }
}

pub trait Add<Rhs = Self> {
    type Output = Self
    fn add(self, other: Rhs) -> Self.Output
}

pub trait Sub<Rhs = Self> {
    type Output = Self
    fn sub(self, other: Rhs) -> Self.Output
}

pub trait Mul<Rhs = Self> {
    type Output = Self
    fn mul(self, other: Rhs) -> Self.Output
}

pub trait Div<Rhs = Self> {
    type Output = Self
    fn div(self, other: Rhs) -> Self.Output
}

pub trait Rem<Rhs = Self> {
    type Output = Self
    fn rem(self, other: Rhs) -> Self.Output
}

/// `a += b` (and `-=`, `*=`, `/=`, `%=`) in place. Without an implementation,
/// `a += b` means `a = a + b`.
pub trait AddAssign<Rhs = Self> {
    fn add_assign(&mut self, other: Rhs)
}

pub trait SubAssign<Rhs = Self> {
    fn sub_assign(&mut self, other: Rhs)
}

pub trait MulAssign<Rhs = Self> {
    fn mul_assign(&mut self, other: Rhs)
}

pub trait DivAssign<Rhs = Self> {
    fn div_assign(&mut self, other: Rhs)
}

pub trait RemAssign<Rhs = Self> {
    fn rem_assign(&mut self, other: Rhs)
}

/// `a[i]`: reading through an index.
pub trait Index<Idx> {
    type Output
    fn index(&self, i: Idx) -> &Self.Output
}

/// `a[i] = v`, `a[i] += v`, `&mut a[i]`: writing through an index.
pub trait IndexMut<Idx> extends Index<Idx> {
    fn index_mut(&mut self, i: Idx) -> &mut Self.Output
}

pub trait Neg {
    type Output = Self
    fn neg(self) -> Self.Output
}

/// Three-way comparison of anything with `<` and `>`: numbers or `Ord` types.
pub fn compare<T>(a: T, b: T) -> Ordering {
    if a < b {
        Ordering.Less
    } else if a > b {
        Ordering.Greater
    } else {
        Ordering.Equal
    }
}


// Built-in types implement the operator traits too, so generic code with
// bounds like `T: Ord` or `T: Add` accepts numbers.

