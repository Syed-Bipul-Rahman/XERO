// Heap memory. Nothing here is used unless you import it:
// pay only for what you use.

module std.mem

import std.sys

/// Allocate uninitialized storage for `count` values of `T`.
pub unsafe fn alloc<T>(count: usize) -> *T {
    let size = size_of<T>() * count
    let p = sys.heap_alloc(if size == 0 { 1 } else { size }) as *T
    if p as usize == 0 {
        panic("out of memory")
    }
    p
}

/// Resize storage previously returned by `alloc`.
pub unsafe fn realloc_array<T>(ptr: *T, count: usize) -> *T {
    let size = size_of<T>() * count
    let p = sys.heap_realloc(ptr as *u8, if size == 0 { 1 } else { size }) as *T
    if p as usize == 0 {
        panic("out of memory")
    }
    p
}

pub unsafe fn dealloc<T>(ptr: *T) {
    sys.heap_free(ptr as *u8)
}

/// Copy `count` values from `src` to `dst` (regions may overlap).
pub unsafe fn copy_values<T>(src: *T, dst: *T, count: usize) {
    sys.mem_move(dst as *u8, src as *u8, size_of<T>() * count)
}

/// Exchange two values without copying either through a temporary owner.
pub fn swap<T>(a: &mut T, b: &mut T) {
    unsafe {
        let pa = a as *T
        let pb = b as *T
        let tmp = ptr_read(pa)
        ptr_write(pa, ptr_read(pb))
        ptr_write(pb, tmp)
    }
}

/// Put `value` into `*dest` and return the previous value.
pub fn replace<T>(dest: &mut T, value: T) -> T {
    unsafe {
        let p = dest as *T
        let old = ptr_read(p)
        ptr_write(p, value)
        old
    }
}

/// A uniquely owned heap allocation, freed deterministically when dropped.
pub struct Box<T> {
    ptr: *T
}

impl<T> Box<T> {
    pub fn new(value: T) -> Box<T> {
        unsafe {
            let p = alloc<T>(1)
            ptr_write(p, value)
            Box { ptr: p }
        }
    }

    pub fn get(&self) -> &T {
        unsafe { &*self.ptr }
    }

    pub fn get_mut(&mut self) -> &mut T {
        unsafe { &mut *self.ptr }
    }

    pub fn set(&mut self, value: T) {
        unsafe { *self.ptr = value }
    }

    /// Move the value out of the box and free the allocation.
    pub fn into_inner(self) -> T {
        unsafe {
            let value = ptr_read(self.ptr)
            sys.heap_free(self.ptr as *u8)
            forget(self)
            value
        }
    }

    pub fn as_ptr(&self) -> *T {
        self.ptr
    }

    drop {
        unsafe {
            drop_in_place(self.ptr)
            sys.heap_free(self.ptr as *u8)
        }
    }
}
