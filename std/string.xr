// An owned, growable UTF-8 string.

module std.string

import std.vec.{Vec}

pub struct String {
    bytes: Vec<u8>
}

impl String {
    pub fn new() -> String {
        String { bytes: Vec.new() }
    }

    pub fn from(s: &str) -> String {
        let mut out = String { bytes: Vec.with_capacity(s.len()) }
        out.push_str(s)
        out
    }

    pub fn len(&self) -> usize {
        self.bytes.len()
    }

    pub fn is_empty(&self) -> bool {
        self.bytes.len() == 0
    }

    pub fn push_str(&mut self, s: &str) {
        for b in s.as_bytes() {
            self.bytes.push(*b)
        }
    }

    pub fn push_byte(&mut self, b: u8) {
        self.bytes.push(b)
    }

    pub fn push_int(&mut self, value: i64) {
        if value < 0 {
            self.bytes.push('-')
        }
        let mut v = if value < 0 { 0 - (value as u64) } else { value as u64 }
        let mut buf = [0u8; 20]
        let mut i: usize = 20
        if v == 0 {
            i -= 1
            buf[i] = '0'
        }
        while v > 0 {
            i -= 1
            buf[i] = '0' + (v % 10) as u8
            v /= 10
        }
        while i < 20 {
            self.bytes.push(buf[i])
            i += 1
        }
    }

    /// Take ownership of `bytes` if they are valid UTF-8.
    pub fn from_utf8(bytes: Vec<u8>) -> Option<String> {
        if !is_utf8(bytes.as_slice()) {
            return None
        }
        Some(String { bytes: bytes })
    }

    /// Take ownership of `bytes`, which the caller promises are valid UTF-8.
    pub unsafe fn from_utf8_unchecked(bytes: Vec<u8>) -> String {
        String { bytes: bytes }
    }

    pub fn as_bytes(&self) -> &[u8] {
        self.bytes.as_slice()
    }

    pub fn into_bytes(self) -> Vec<u8> {
        self.bytes
    }

    pub fn as_str(&self) -> &str {
        let s = self.bytes.as_slice()
        unsafe { str_from_raw(s as *u8, s.len()) }
    }

    pub fn clear(&mut self) {
        self.bytes.clear()
    }

    pub fn equals(&self, other: &str) -> bool {
        self.as_str() == other
    }
}

/// Is `b` well-formed UTF-8 (no overlong forms, surrogates or values
/// above U+10FFFF)?
pub fn is_utf8(b: &[u8]) -> bool {
    let n = b.len()
    let mut i: usize = 0
    while i < n {
        let c = b[i]
        if c < 0x80 {
            i += 1
            continue
        }
        let (len, lo, hi) = if c >= 0xC2 && c <= 0xDF {
            (2 as usize, 0x80u8, 0xBFu8)
        } else if c == 0xE0 {
            (3, 0xA0u8, 0xBFu8)
        } else if c == 0xED {
            (3, 0x80u8, 0x9Fu8)
        } else if c >= 0xE1 && c <= 0xEF {
            (3, 0x80u8, 0xBFu8)
        } else if c == 0xF0 {
            (4, 0x90u8, 0xBFu8)
        } else if c >= 0xF1 && c <= 0xF3 {
            (4, 0x80u8, 0xBFu8)
        } else if c == 0xF4 {
            (4, 0x80u8, 0x8Fu8)
        } else {
            return false
        }
        if i + len > n {
            return false
        }
        // the second byte has a narrower range; the rest are continuation bytes
        if b[i + 1] < lo || b[i + 1] > hi {
            return false
        }
        let mut j: usize = 2
        while j < len {
            if b[i + j] < 0x80 || b[i + j] > 0xBF {
                return false
            }
            j += 1
        }
        i += len
    }
    true
}

impl Print for String {
    fn write_to(&self, fd: i32) {
        write_str(fd, self.as_str())
    }
}
