// The program's environment: its command-line arguments, environment
// variables and current directory.

module std.env

import std.fs
import std.mem
import std.os
import std.sys

/// The number of command-line arguments, including the program name.
pub fn arg_count() -> usize {
    os_argc()
}

/// Command-line argument `i` (0 is the program name), or `None`.
pub fn arg(i: usize) -> Option<&str> {
    if i >= os_argc() {
        return None
    }
    unsafe {
        let p = *(os_argv() + i)
        let mut n: usize = 0
        while *(p + n) != 0 {
            n += 1
        }
        Some(str_from_raw(p, n))
    }
}

/// All command-line arguments, including the program name.
pub fn args() -> Vec<&str> {
    let mut v: Vec<&str> = Vec.with_capacity(os_argc())
    let mut i: usize = 0
    while arg(i) is Some(a) {
        v.push(a)
        i += 1
    }
    v
}

// The environment as the program started is a fixed array. The first
// `set_var` or `remove_var` copies it into `TABLE` (`NAME=value\0` byte
// strings), which from then on is the environment; `LOCK` guards it.
static mut LOCK: u32 = 0
static mut TABLE: usize = 0

struct EnvTable {
    entries: Vec<Vec<u8>>
}

unsafe fn lock() {
    while atomic_cas(&mut LOCK as *u32, 0, 1) != 0 {
        sys.yield_now()
    }
}

unsafe fn unlock() {
    atomic_store(&mut LOCK as *u32, 0)
}

/// The changed environment (made from the original on first use); the
/// lock must be held.
unsafe fn table() -> *EnvTable {
    if TABLE == 0 {
        let t = mem.alloc<EnvTable>(1)
        let mut entries: Vec<Vec<u8>> = Vec.new()
        let mut e = sys.env_block()
        if e as usize != 0 {
            while *e as usize != 0 {
                let mut b = c_bytes(*e)
                b.push(0)
                entries.push(b)
                e = e + 1
            }
        }
        ptr_write(t, EnvTable { entries: entries })
        TABLE = t as usize
    }
    TABLE as *EnvTable
}

/// Does entry `s` (`NAME=value`) have the name `want`? Its value then
/// starts at the returned offset.
fn name_matches(s: &[u8], want: &[u8]) -> Option<usize> {
    let fold = os.NAME == "windows"
    if s.len() <= want.len() || s[want.len()] != '=' {
        return None
    }
    for i in 0..want.len() {
        if s[i] != want[i] && !(fold && lower(s[i]) == lower(want[i])) {
            return None
        }
    }
    Some(want.len() + 1)
}

/// A copy of every entry as `NAME=value` with a terminating NUL (what a
/// new process gets).
pub fn entries() -> Vec<Vec<u8>> {
    let mut out: Vec<Vec<u8>> = Vec.new()
    unsafe {
        lock()
        if TABLE != 0 {
            out = (*table()).entries.clone()
        } else {
            let mut e = sys.env_block()
            if e as usize != 0 {
                while *e as usize != 0 {
                    let mut b = c_bytes(*e)
                    b.push(0)
                    out.push(b)
                    e = e + 1
                }
            }
        }
        unlock()
    }
    out
}

/// The value of the environment variable `name`, if it is set (and is
/// valid UTF-8). On Windows, names ignore ASCII case (`Path` is `PATH`).
pub fn var(name: &str) -> Option<String> {
    let want = name.as_bytes()
    for e in entries() {
        if name_matches(e.as_slice(), want) is Some(at) {
            let value = e.as_slice()
            return String.from_utf8(value[at..value.len() - 1].to_vec())
        }
    }
    None
}

/// Every environment variable as `(name, value)` (those that are valid UTF-8).
pub fn vars() -> Vec<(String, String)> {
    let mut out: Vec<(String, String)> = Vec.new()
    for e in entries() {
        let b = e.as_slice()
        if String.from_utf8(b[..b.len() - 1].to_vec()) is Some(entry) {
            // on Windows, names of drive variables start with `=`
            if entry.as_str().split_once("=") is Some((k, v)) {
                if !k.is_empty() {
                    out.push((k.to_string(), v.to_string()))
                }
            }
        }
    }
    out
}

fn check_name(name: &str) {
    for b in name.as_bytes() {
        if *b == '=' || *b == 0 {
            panic("env: a variable name cannot contain `=` or a NUL byte")
        }
    }
    if name.is_empty() {
        panic("env: a variable name cannot be empty")
    }
}

/// Set the environment variable `name` to `value`, for this program and
/// the programs it starts.
pub fn set_var(name: &str, value: &str) {
    check_name(name)
    for b in value.as_bytes() {
        if *b == 0 {
            panic("env: a variable value cannot contain a NUL byte")
        }
    }
    let mut entry: Vec<u8> = Vec.with_capacity(name.len() + value.len() + 2)
    entry.extend_from_slice(name.as_bytes())
    entry.push('=')
    entry.extend_from_slice(value.as_bytes())
    entry.push(0)
    unsafe {
        lock()
        let t = table()
        let mut i: usize = 0
        let mut found = false
        while i < (*t).entries.len() {
            if name_matches((*t).entries[i].as_slice(), name.as_bytes()).is_some() {
                found = true
                break
            }
            i += 1
        }
        if found {
            (*t).entries[i] = entry
        } else {
            (*t).entries.push(entry)
        }
        unlock()
    }
}

/// Remove the environment variable `name` (nothing happens if it is not set).
pub fn remove_var(name: &str) {
    check_name(name)
    unsafe {
        lock()
        let t = table()
        let mut i: usize = 0
        while i < (*t).entries.len() {
            if name_matches((*t).entries[i].as_slice(), name.as_bytes()).is_some() {
                (*t).entries.remove(i)
            } else {
                i += 1
            }
        }
        unlock()
    }
}

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

/// The bytes of a NUL-terminated string.
unsafe fn c_bytes(p: *u8) -> Vec<u8> {
    let mut v: Vec<u8> = Vec.new()
    let mut i: usize = 0
    while *(p + i) != 0 {
        v.push(*(p + i))
        i += 1
    }
    v
}

/// The current working directory.
pub fn current_dir() -> Result<String, fs.Error> {
    let mut buf = [0u8; 4096]
    let n = unsafe { sys.cwd(&mut buf as *u8, 4096) }
    if n < 0 {
        throw fs.error_from(0 - n as i32)
    }
    let mut v: Vec<u8> = Vec.with_capacity(n as usize)
    for i in 0..n as usize {
        v.push(buf[i])
    }
    match String.from_utf8(v) {
        Some(s) => Ok(s)
        None => Err(fs.error_from(-1))
    }
}

/// Change the current working directory.
pub fn set_current_dir(path: &str) -> Result<(), fs.Error> {
    let mut buf = [0u8; 4096]
    try fs.c_path(path, &mut buf)
    let r = unsafe { sys.chdir_path(&buf as *u8) }
    if r < 0 {
        throw fs.error_from(0 - r)
    }
    Ok(())
}
