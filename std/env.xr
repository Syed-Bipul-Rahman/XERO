// The program's environment: its command-line arguments, environment
// variables and current directory.

module std.env

import std.fs
import std.os
import std.sys

/// The number of command-line arguments, including the program name.
pub fn arg_count() -> usize {
    os_argc()
}

/// Command-line argument `i` (0 is the program name), or `None`.
pub fn arg(i: usize) -> Option<&str> {
    if i >= os_argc() {
        return None
    }
    unsafe {
        let p = *(os_argv() + i)
        let mut n: usize = 0
        while *(p + n) != 0 {
            n += 1
        }
        Some(str_from_raw(p, n))
    }
}

/// All command-line arguments, including the program name.
pub fn args() -> Vec<&str> {
    let mut v: Vec<&str> = Vec.with_capacity(os_argc())
    let mut i: usize = 0
    while arg(i) is Some(a) {
        v.push(a)
        i += 1
    }
    v
}

/// The value of the environment variable `name`, if it is set (and is
/// valid UTF-8). On Windows, names ignore ASCII case (`Path` is `PATH`).
pub fn var(name: &str) -> Option<String> {
    let want = name.as_bytes()
    let fold = os.NAME == "windows"
    unsafe {
        let mut e = sys.env_block()
        if e as usize == 0 {
            return None
        }
        while *e as usize != 0 {
            let s = *e
            let mut i: usize = 0
            while i < want.len() && (*(s + i) == want[i] || (fold && lower(*(s + i)) == lower(want[i]))) {
                i += 1
            }
            if i == want.len() && *(s + i) == '=' {
                let v = s + i + 1
                return String.from_utf8(c_bytes(v))
            }
            e = e + 1
        }
    }
    None
}

/// Every environment variable as `(name, value)` (those that are valid UTF-8).
pub fn vars() -> Vec<(String, String)> {
    let mut out: Vec<(String, String)> = Vec.new()
    unsafe {
        let mut e = sys.env_block()
        if e as usize == 0 {
            return out
        }
        while *e as usize != 0 {
            if String.from_utf8(c_bytes(*e)) is Some(entry) {
                // on Windows, names of drive variables start with `=`
                if entry.as_str().split_once("=") is Some((k, v)) {
                    if !k.is_empty() {
                        out.push((k.to_string(), v.to_string()))
                    }
                }
            }
            e = e + 1
        }
    }
    out
}

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

/// The bytes of a NUL-terminated string.
unsafe fn c_bytes(p: *u8) -> Vec<u8> {
    let mut v: Vec<u8> = Vec.new()
    let mut i: usize = 0
    while *(p + i) != 0 {
        v.push(*(p + i))
        i += 1
    }
    v
}

/// The current working directory.
pub fn current_dir() -> Result<String, fs.Error> {
    let mut buf = [0u8; 4096]
    let n = unsafe { sys.cwd(&mut buf as *u8, 4096) }
    if n < 0 {
        throw fs.error_from(0 - n as i32)
    }
    let mut v: Vec<u8> = Vec.with_capacity(n as usize)
    for i in 0..n as usize {
        v.push(buf[i])
    }
    match String.from_utf8(v) {
        Some(s) => Ok(s)
        None => Err(fs.error_from(-1))
    }
}

/// Change the current working directory.
pub fn set_current_dir(path: &str) -> Result<(), fs.Error> {
    let mut buf = [0u8; 4096]
    try fs.c_path(path, &mut buf)
    let r = unsafe { sys.chdir_path(&buf as *u8) }
    if r < 0 {
        throw fs.error_from(0 - r)
    }
    Ok(())
}
