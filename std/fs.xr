// Files. A `File` is closed when it is destroyed.

module std.fs

import std.sys
import std.sys.target
import std.os

/// An error from the operating system, such as a missing file.
pub copy struct Error {
    code: i32
}

const NOT_UTF8: i32 = -1
const PATH_TOO_LONG: i32 = -2

impl Error {
    /// The OS error number (`errno`), or a negative value for errors
    /// detected by Xero itself.
    pub fn code(&self) -> i32 {
        self.code
    }

    /// A short description of the error.
    pub fn message(&self) -> &str {
        let c = self.code
        if c == NOT_UTF8 {
            "file is not valid UTF-8"
        } else if c == PATH_TOO_LONG {
            "path is too long or contains a NUL byte"
        } else if c == 2 {
            "no such file or directory"
        } else if c == 13 {
            "permission denied"
        } else if c == 17 {
            "file exists"
        } else if c == 20 {
            "not a directory"
        } else if c == 21 {
            "is a directory"
        } else if c == 24 {
            "too many open files"
        } else if c == 28 {
            "no space left on device"
        } else if c == target.ENOTEMPTY {
            "directory not empty"
        } else if c == 8 {
            "not an executable program"
        } else if c == 38 {
            "not supported on this system"
        } else {
            "I/O error"
        }
    }
}

/// An error from an OS error number.
pub fn error_from(code: i32) -> Error {
    Error { code: code }
}

impl Display for Error {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.message())
    }
}

impl Print for Error {
    fn write_to(&self, fd: i32) {
        write_str(fd, self.message())
    }
}

/// Copy `path` into `buf` with a terminating NUL, as the OS wants it.
pub fn c_path(path: &str, buf: &mut [u8; 4096]) -> Result<(), Error> {
    let bytes = path.as_bytes()
    if bytes.len() >= 4096 {
        throw Error { code: PATH_TOO_LONG }
    }
    let mut i: usize = 0
    while i < bytes.len() {
        if bytes[i] == 0 {
            throw Error { code: PATH_TOO_LONG }
        }
        buf[i] = bytes[i]
        i += 1
    }
    buf[i] = 0
    Ok(())
}

/// Open `path` with mode 0 (read), 1 (write) or 2 (append).
fn open_mode(path: &str, mode: i32) -> Result<File, Error> {
    let mut buf = [0u8; 4096]
    try c_path(path, &mut buf)
    let fd = unsafe { sys.fd_open(&buf as *u8, mode) }
    if fd < 0 {
        throw Error { code: 0 - fd }
    }
    Ok(File { fd: fd })
}

/// An open file.
pub struct File {
    fd: i32
}

impl File {
    /// Open an existing file for reading.
    pub fn open(path: &str) -> Result<File, Error> {
        open_mode(path, 0)
    }

    /// Open a file for writing, creating it or emptying it first.
    pub fn create(path: &str) -> Result<File, Error> {
        open_mode(path, 1)
    }

    /// Open a file for writing at its end, creating it if needed.
    pub fn append(path: &str) -> Result<File, Error> {
        open_mode(path, 2)
    }

    /// Read up to `buf.len()` bytes; returns how many were read (0 at the end).
    pub fn read(&mut self, buf: &mut [u8]) -> Result<usize, Error> {
        let len = buf.len()
        let n = unsafe { sys.fd_read(self.fd, buf as *u8, len) }
        if n < 0 {
            throw Error { code: (0 - n) as i32 }
        }
        Ok(n as usize)
    }

    /// Read everything from the current position to the end.
    pub fn read_all(&mut self) -> Result<Vec<u8>, Error> {
        let mut out: Vec<u8> = Vec.new()
        let mut buf = [0u8; 8192]
        loop {
            let n = try self.read(&mut buf)
            if n == 0 {
                break
            }
            let mut i: usize = 0
            while i < n {
                out.push(buf[i])
                i += 1
            }
        }
        Ok(out)
    }

    /// Read the rest of the file as UTF-8 text.
    pub fn read_to_string(&mut self) -> Result<String, Error> {
        let bytes = try self.read_all()
        match String.from_utf8(bytes) {
            Some(s) => Ok(s)
            None => Err(Error { code: NOT_UTF8 })
        }
    }

    /// Write all of `bytes`.
    pub fn write(&mut self, bytes: &[u8]) -> Result<(), Error> {
        let mut done: usize = 0
        while done < bytes.len() {
            let n = unsafe { sys.fd_write(self.fd, (bytes as *u8) + done, bytes.len() - done) }
            if n < 0 {
                throw Error { code: (0 - n) as i32 }
            }
            done += n as usize
        }
        Ok(())
    }

    /// Write all of `text`.
    pub fn write_str(&mut self, text: &str) -> Result<(), Error> {
        self.write(text.as_bytes())
    }

    drop {
        unsafe { sys.fd_close(self.fd) }
    }
}

/// Read a whole file as UTF-8 text.
pub fn read_to_string(path: &str) -> Result<String, Error> {
    let mut f = try File.open(path)
    f.read_to_string()
}

/// Read a whole file as bytes.
pub fn read(path: &str) -> Result<Vec<u8>, Error> {
    let mut f = try File.open(path)
    f.read_all()
}

/// Create (or replace) the file at `path` with `bytes` as its contents.
pub fn write(path: &str, bytes: &[u8]) -> Result<(), Error> {
    let mut f = try File.create(path)
    f.write(bytes)
}

/// Delete the file at `path`. (On Windows, a file that is open cannot be deleted.)
pub fn remove(path: &str) -> Result<(), Error> {
    let mut buf = [0u8; 4096]
    try c_path(path, &mut buf)
    let r = unsafe { sys.file_remove(&buf as *u8) }
    if r < 0 {
        throw Error { code: 0 - r }
    }
    Ok(())
}

/// Run `f` on the NUL-terminated `path`; an error for a negative result.
fn path_call(path: &str, f: fn(*u8) -> i32) -> Result<(), Error> {
    let mut buf = [0u8; 4096]
    try c_path(path, &mut buf)
    let r = f(&buf as *u8)
    if r < 0 {
        throw Error { code: 0 - r }
    }
    Ok(())
}

fn sys_dir_create(p: *u8) -> i32 {
    unsafe { sys.dir_create(p) }
}

fn sys_dir_remove(p: *u8) -> i32 {
    unsafe { sys.dir_remove(p) }
}

/// Create the directory `path` (its parent must exist).
pub fn create_dir(path: &str) -> Result<(), Error> {
    path_call(path, sys_dir_create)
}

/// Create the directory `path` and any missing parents; fine if it exists.
pub fn create_dir_all(path: &str) -> Result<(), Error> {
    if is_dir(path) {
        return Ok(())
    }
    if parent(path) is Some(p) {
        try create_dir_all(p)
    }
    match create_dir(path) {
        Ok(()) => Ok(())
        // another thread or process may have made it meanwhile
        Err(e) => if is_dir(path) { Ok(()) } else { Err(e) }
    }
}

/// `path` without its last component: `"a/b/c"` gives `"a/b"`; `None`
/// for a path with only one component.
pub fn parent(path: &str) -> Option<&str> {
    let b = path.as_bytes()
    let mut end = b.len()
    while end > 1 && is_sep(b[end - 1]) {
        end -= 1
    }
    let mut i = end
    while i > 0 && !is_sep(b[i - 1]) {
        i -= 1
    }
    if i == 0 {
        return None
    }
    // drop the separators, but keep a root `/`
    while i > 1 && is_sep(b[i - 1]) {
        i -= 1
    }
    Some(&path[..i])
}

fn is_sep(c: u8) -> bool {
    c == '/' || (c == '\\' && os.NAME == "windows")
}

/// `dir` and `name` joined with a separator.
pub fn join(dir: &str, name: &str) -> String {
    let mut s = String.from(dir)
    if !dir.is_empty() && !is_sep(dir.as_bytes()[dir.len() - 1]) {
        s.push_byte('/')
    }
    s.push_str(name)
    s
}

/// Remove the empty directory `path`.
pub fn remove_dir(path: &str) -> Result<(), Error> {
    path_call(path, sys_dir_remove)
}

/// Remove `path` and everything in it (or the file `path`).
pub fn remove_dir_all(path: &str) -> Result<(), Error> {
    let m = try metadata(path)
    if !m.is_dir() {
        return remove(path)
    }
    for name in try read_dir(path) {
        let child = join(path, name.as_str())
        try remove_dir_all(child.as_str())
    }
    remove_dir(path)
}

/// Rename (move) `from` to `to`, replacing a file at `to`.
pub fn rename(from: &str, to: &str) -> Result<(), Error> {
    let mut a = [0u8; 4096]
    let mut b = [0u8; 4096]
    try c_path(from, &mut a)
    try c_path(to, &mut b)
    let r = unsafe { sys.path_rename(&a as *u8, &b as *u8) }
    if r < 0 {
        throw Error { code: 0 - r }
    }
    Ok(())
}

/// What `metadata` reports about a path.
pub copy struct Metadata {
    kind: u64
    len: u64
}

impl Metadata {
    pub fn is_file(&self) -> bool {
        self.kind == 1
    }

    pub fn is_dir(&self) -> bool {
        self.kind == 2
    }

    /// The size in bytes (of a file).
    pub fn len(&self) -> u64 {
        self.len
    }
}

/// Whether `path` is a file, a directory or something else, and its size.
pub fn metadata(path: &str) -> Result<Metadata, Error> {
    let mut buf = [0u8; 4096]
    try c_path(path, &mut buf)
    let mut out = [0u64; 2]
    let r = unsafe { sys.path_stat(&buf as *u8, &mut out as *u64) }
    if r < 0 {
        throw Error { code: 0 - r }
    }
    Ok(Metadata { kind: out[0], len: out[1] })
}

/// Whether anything exists at `path`.
pub fn exists(path: &str) -> bool {
    metadata(path).is_ok()
}

pub fn is_file(path: &str) -> bool {
    match metadata(path) {
        Ok(m) => m.is_file()
        Err(_) => false
    }
}

pub fn is_dir(path: &str) -> bool {
    match metadata(path) {
        Ok(m) => m.is_dir()
        Err(_) => false
    }
}

/// The names in the directory `path` (without `.` and `..`), in no
/// particular order.
pub fn read_dir(path: &str) -> Result<Vec<String>, Error> {
    let mut buf = [0u8; 4096]
    try c_path(path, &mut buf)
    let h = unsafe { sys.dir_open(&buf as *u8) }
    if h < 0 {
        throw Error { code: 0 - h as i32 }
    }
    let mut names: Vec<String> = Vec.new()
    let mut name = [0u8; 1024]
    loop {
        let n = unsafe { sys.dir_next(h, &mut name as *u8) }
        if n < 0 {
            unsafe { sys.dir_close(h) }
            throw Error { code: 0 - n as i32 }
        }
        if n == 0 {
            break
        }
        let s = unsafe { str_from_raw(&name as *u8, n as usize) }
        if s != "." && s != ".." {
            // names that are not UTF-8 are skipped
            if String.from_utf8(copy_bytes(s.as_bytes())) is Some(t) {
                names.push(t)
            }
        }
    }
    unsafe { sys.dir_close(h) }
    Ok(names)
}

fn copy_bytes(b: &[u8]) -> Vec<u8> {
    let mut v: Vec<u8> = Vec.with_capacity(b.len())
    for c in b {
        v.push(*c)
    }
    v
}
