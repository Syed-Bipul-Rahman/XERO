// Hash tables: HashMap<K, V> and HashSet<T>.
//
// Open addressing with linear probing over a power-of-two table that
// grows when three quarters full (counting removed slots). Keys need
// `Hash` and `Eq`; lookups take anything the key type can be viewed as
// (`Borrow`), so a `HashMap<String, V>` is searched with a `&str`.

module std.collections

import std.mem

enum Slot<K, V> {
    Empty
    Removed
    Full(K, V)
}

/// A map from keys to values.
pub struct HashMap<K, V> {
    slots: Vec<Slot<K, V>>
    len: usize
    /// Full and removed slots: what probing has to walk over.
    used: usize
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    pub fn new() -> HashMap<K, V> {
        HashMap { slots: Vec.new(), len: 0, used: 0 }
    }

    /// Room for `n` entries before the table grows.
    pub fn with_capacity(n: usize) -> HashMap<K, V> {
        let mut m: HashMap<K, V> = HashMap.new()
        m.resize(table_size(n))
        m
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    /// Remove every entry.
    pub fn clear(&mut self) {
        let n = self.slots.len()
        self.slots.clear()
        for _ in 0..n {
            self.slots.push(Slot.Empty)
        }
        self.len = 0
        self.used = 0
    }

    fn resize(&mut self, size: usize) {
        let old = mem.replace(&mut self.slots, Vec.with_capacity(size))
        for _ in 0..size {
            self.slots.push(Slot.Empty)
        }
        self.len = 0
        self.used = 0
        for s in old {
            if s is Slot.Full(k, v) {
                self.insert_new(k, v);
            }
        }
    }

    /// Put a key known to be absent into the table (which has room);
    /// returns its slot.
    fn insert_new(&mut self, k: K, v: V) -> usize {
        let mask = self.slots.len() - 1
        let mut i = (hash_of(&k) as usize) & mask
        loop {
            match self.slots[i] {
                Slot.Full(_, _) => i = (i + 1) & mask
                _ => break
            }
        }
        if self.slots[i] is Slot.Empty {
            self.used += 1
        }
        self.slots[i] = Slot.Full(k, v)
        self.len += 1
        i
    }

    /// The slot holding `key`, if any.
    fn find<Q>(&self, key: &Q) -> Option<usize> where K: Borrow<Q> {
        let n = self.slots.len()
        if n == 0 {
            return None
        }
        let mask = n - 1
        let mut i = (hash_of(key) as usize) & mask
        let mut probes: usize = 0
        while probes < n {
            match &self.slots[i] {
                Slot.Empty => return None
                Slot.Full(k, _) => {
                    if borrow_as<K, Q>(k) == key {
                        return Some(i)
                    }
                }
                Slot.Removed => {}
            }
            i = (i + 1) & mask
            probes += 1
        }
        None
    }

    /// Add or replace the value for `key`; returns the old value.
    pub fn insert(&mut self, key: K, value: V) -> Option<V> {
        if self.find(&key) is Some(i) {
            if let_slot_value(&mut self.slots[i]) is Some(old) {
                return Some(mem.replace(old, value))
            }
        }
        self.insert_absent(key, value);
        None
    }

    /// Insert a key known to be absent, growing first if needed; returns its slot.
    fn insert_absent(&mut self, key: K, value: V) -> usize {
        if (self.used + 1) * 4 > self.slots.len() * 3 {
            // grow (or, after many removals, just clean up)
            let size = if (self.len + 1) * 2 > self.slots.len() {
                table_size(self.len + 1)
            } else {
                self.slots.len()
            }
            self.resize(if size < 8 { 8 } else { size })
        }
        self.insert_new(key, value)
    }

    pub fn get<Q>(&self, key: &Q) -> Option<&V> where K: Borrow<Q> {
        match self.find(key) {
            Some(i) => match &self.slots[i] {
                Slot.Full(_, v) => Some(v)
                _ => None
            }
            None => None
        }
    }

    pub fn get_mut<Q>(&mut self, key: &Q) -> Option<&mut V> where K: Borrow<Q> {
        match self.find(key) {
            Some(i) => let_slot_value(&mut self.slots[i])
            None => None
        }
    }

    pub fn contains_key<Q>(&self, key: &Q) -> bool where K: Borrow<Q> {
        self.find(key).is_some()
    }

    /// Take the entry for `key` out; returns its value.
    pub fn remove<Q>(&mut self, key: &Q) -> Option<V> where K: Borrow<Q> {
        let i = self.find(key) catch {
            return None
        }
        let old = mem.replace(&mut self.slots[i], Slot.Removed)
        self.len -= 1
        match old {
            Slot.Full(_, v) => Some(v)
            _ => None
        }
    }

    /// The value for `key`, inserting `make()` first if there is none:
    /// `*counts.get_or_insert_with(word, || 0) += 1`.
    pub fn get_or_insert_with<F: FnOnce() -> V>(&mut self, key: K, make: F) -> &mut V {
        let i = match self.find(&key) {
            Some(i) => i
            None => self.insert_absent(key, make())
        }
        let_slot_value(&mut self.slots[i]).unwrap()
    }

    /// Entries as `(&key, &value)`, in no particular order.
    pub fn iter(&self) -> MapIter<K, V> {
        MapIter { slots: self.slots.as_slice(), i: 0 }
    }

    pub fn keys(&self) -> Keys<K, V> {
        Keys { it: self.iter() }
    }

    pub fn values(&self) -> Values<K, V> {
        Values { it: self.iter() }
    }
}

/// The value in a full slot.
fn let_slot_value<K, V>(s: &mut Slot<K, V>) -> Option<&mut V> {
    match s {
        Slot.Full(_, v) => Some(v)
        _ => None
    }
}

/// A power-of-two table size with room for `n` entries at 3/4 load.
fn table_size(n: usize) -> usize {
    let mut size: usize = 8
    while size * 3 < n * 4 {
        size *= 2
    }
    size
}

pub struct MapIter<K, V> {
    slots: &[Slot<K, V>]
    i: usize
}

impl<K, V> Iterator for MapIter<K, V> {
    type Item = (&K, &V)
    fn next(&mut self) -> Option<(&K, &V)> {
        while self.i < self.slots.len() {
            let i = self.i
            self.i += 1
            if &self.slots[i] is Slot.Full(k, v) {
                return Some((k, v))
            }
        }
        None
    }
}

pub struct Keys<K, V> {
    it: MapIter<K, V>
}

impl<K, V> Iterator for Keys<K, V> {
    type Item = &K
    fn next(&mut self) -> Option<&K> {
        match self.it.next() {
            Some(p) => Some(p.0)
            None => None
        }
    }
}

pub struct Values<K, V> {
    it: MapIter<K, V>
}

impl<K, V> Iterator for Values<K, V> {
    type Item = &V
    fn next(&mut self) -> Option<&V> {
        match self.it.next() {
            Some(p) => Some(p.1)
            None => None
        }
    }
}

/// `map[&key]`: the value, or a panic if the key is missing.
impl<K: Hash + Eq, V> Index<&K> for HashMap<K, V> {
    type Output = V
    fn index(&self, key: &K) -> &V {
        match self.get(key) {
            Some(v) => v
            None => panic("HashMap: key not found")
        }
    }
}

/// `map["key"]` on a map with `String` keys.
impl<V> Index<&str> for HashMap<String, V> {
    type Output = V
    fn index(&self, key: &str) -> &V {
        match self.get(key) {
            Some(v) => v
            None => panic("HashMap: key not found")
        }
    }
}

/// A set of distinct values.
pub struct HashSet<T> {
    map: HashMap<T, ()>
}

impl<T: Hash + Eq> HashSet<T> {
    pub fn new() -> HashSet<T> {
        HashSet { map: HashMap.new() }
    }

    pub fn len(&self) -> usize {
        self.map.len()
    }

    pub fn is_empty(&self) -> bool {
        self.map.is_empty()
    }

    /// Add `value`; false if it was already there.
    pub fn insert(&mut self, value: T) -> bool {
        self.map.insert(value, ()).is_none()
    }

    pub fn contains<Q>(&self, value: &Q) -> bool where T: Borrow<Q> {
        self.map.contains_key(value)
    }

    /// Take `value` out; false if it was not there.
    pub fn remove<Q>(&mut self, value: &Q) -> bool where T: Borrow<Q> {
        self.map.remove(value).is_some()
    }

    pub fn clear(&mut self) {
        self.map.clear()
    }

    /// The values, in no particular order.
    pub fn iter(&self) -> Keys<T, ()> {
        self.map.keys()
    }
}
